{
  "name": "artifacts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run check && vite build",
    "check": "tsc -b",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "preview": "pnpm run build && vite preview --host",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "mkdir -p .wrangler && wrangler types ./.wrangler/worker-configuration.d.ts",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.23",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/har-format": "^1.2.16",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@11.25.0"
}
