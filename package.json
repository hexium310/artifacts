{
  "name": "artifacts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run check && vite build",
    "check": "tsc -b",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "preview": "pnpm run build && vite preview --host",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "mkdir -p .wrangler && wrangler types ./.wrangler/worker-configuration.d.ts",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.3",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.0.6",
    "@types/har-format": "^1.2.16",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  },
  "packageManager": "pnpm@11.5.2"
}
