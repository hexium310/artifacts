{
  "name": "artifacts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run check && vite build",
    "check": "tsc -b",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "preview": "pnpm run build && vite preview --host",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "mkdir .wrangler && wrangler types ./.wrangler/worker-configuration.d.ts",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.18",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.21.0",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.3",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^7.0.2",
    "@types/har-format": "^1.2.16",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.0.0",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.59.2"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "allowBuilds": {
      "esbuild": false,
      "sharp": false,
      "workerd": false,
      "unrs-resolver": false
    }
  }
}
